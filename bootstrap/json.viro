json: object []

json.tokens-from-json: fn [string] [
  tokens: copy []
  line: 1
  column: 1
  idx: 1
  length: length? string
  state: 'base
  escape?: false
  string-buffer: ""
  string-line: 0
  string-column: 0
  string-for-key?: false
  contexts: copy []
  object-modes: copy []
  array-modes: copy []
  depth: 0
  root-mode: 'value
  word: ""
  word-line: 1
  word-column: 1
  word-charset: "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789+-."

  append-token: fn --no-scope [type value token-line token-column] [
    append tokens make object! [
      type: type
      value: value
      line: token-line
      column: token-column
    ]
    tokens
  ]

  current-context: fn --no-scope [] [
    if depth = 0 [none] [pick contexts depth]
  ]

  ensure-value: fn --no-scope [] [
    if depth = 0 [
      root-mode = 'value
    ] [
      type: current-context
      if type = 'object [
        mode: pick object-modes depth
        mode = 'value
      ] [
        if type = 'array [
          mode: pick array-modes depth
          any [mode = 'start mode = 'value]
        ] [
          false
        ]
      ]
    ]
  ]

  note-value-produced: fn --no-scope [] [
    if depth = 0 [
      if root-mode = 'value [
        root-mode: 'done
        true
      ] [
        false
      ]
    ] [
      type: current-context
      if type = 'object [
        poke object-modes depth 'value-done
        true
      ] [
        if type = 'array [
          poke array-modes depth 'value-done
          true
        ] [
          false
        ]
      ]
    ]
  ]

  json-number?: fn --no-scope [text] [
    when (length? text) = 0 [return false]
    first-char: to-string pick text 1
    when not find "0123456789-" first-char [return false]
    allowed: "0123456789+-eE."
    foreach text ch [
      ch-string: to-string ch
      when not find allowed ch-string [return false]
    ]
    true
  ]

  flush-word: fn --no-scope [] [
    when (length? word) > 0 [
      value: word
      value-line: word-line
      value-column: word-column
      word: ""
      if value = "null" [
        when not ensure-value [return false]
        append-token 'literal "none" value-line value-column
        when not note-value-produced [return false]
      ] [
        if any [value = "true" value = "false"] [
          when not ensure-value [return false]
          append-token 'literal value value-line value-column
          when not note-value-produced [return false]
        ] [
          when not json-number? value [return false]
          when not ensure-value [return false]
          append-token 'literal value value-line value-column
          when not note-value-produced [return false]
        ]
      ]
    ]
    true
  ]

  add-context: fn --no-scope [kind] [
    depth: depth + 1
    if depth <= length? contexts [
      poke contexts depth kind
    ] [
      append contexts kind
    ]
    if kind = 'object [
      if depth <= length? object-modes [
        poke object-modes depth 'key
      ] [
        append object-modes 'key
      ]
      if depth <= length? array-modes [
        poke array-modes depth none
      ] [
        append array-modes none
      ]
    ] [
      if depth <= length? object-modes [
        poke object-modes depth none
      ] [
        append object-modes none
      ]
      if depth <= length? array-modes [
        poke array-modes depth 'start
      ] [
        append array-modes 'start
      ]
    ]
  ]

  drop-context: fn --no-scope [] [
    when depth <= length? contexts [
      poke contexts depth none
    ]
    when depth <= length? object-modes [
      poke object-modes depth none
    ]
    when depth <= length? array-modes [
      poke array-modes depth none
    ]
    depth: depth - 1
  ]

  while [idx <= length] [
    char: pick string idx
    char-line: line
    char-column: column
    char-string: to-string char

    if state = 'string [
      if escape? [
        if char = "u" [return none] [
          value-char: none
          when char = "\"" [value-char: "\""]
          when value-char = none [when char = "\\" [value-char: "\\"]]
          when value-char = none [when char = "/" [value-char: "/"]]
          when value-char = none [when char = "b" [return none]]
          when value-char = none [when char = "f" [return none]]
          when value-char = none [when char = "n" [value-char: "\n"]]
          when value-char = none [when char = "r" [value-char: "\r"]]
          when value-char = none [when char = "t" [value-char: "\t"]]
          when value-char = none [return none]
          append string-buffer value-char
          escape?: false
        ]
      ] [
        if char = "\"" [
          state: 'base
          if string-for-key? [
            if (depth > 0) and (current-context = 'object) [
              mode: pick object-modes depth
              when mode <> 'key [return none]
              key-token: rejoin [string-buffer ":"]
              append-token 'literal key-token string-line string-column
              poke object-modes depth 'colon
            ] [
              return none
            ]
          ] [
            when not ensure-value [return none]
            append-token 'string string-buffer string-line string-column
            when not note-value-produced [return none]
          ]
          string-buffer: ""
          string-for-key?: false
        ] [
          if char = "\\" [
            escape?: true
          ] [
            when any [char = "\n" char = "\r"] [return none]
            append string-buffer char
          ]
        ]
      ]
    ] [
      handled?: false

      when char = "\"" [
        when not flush-word [return none]
        string-buffer: ""
        string-line: char-line
        string-column: char-column
        string-for-key?: false
        when depth > 0 [
          when current-context = 'object [
            mode: pick object-modes depth
            when mode = 'key [
              string-for-key?: true
            ]
          ]
        ]
        state: 'string
        escape?: false
        handled?: true
      ]

      when not handled? [
        when char = "{" [
          when not flush-word [return none]
          when not ensure-value [return none]
          append-token 'literal "object" char-line char-column
          append-token 'lbracket "[" char-line char-column
          add-context 'object
          handled?: true
        ]
      ]

      when not handled? [
        when char = "}" [
          when not flush-word [return none]
          when depth = 0 [return none]
          when current-context <> 'object [return none]
          mode: pick object-modes depth
          when not any [mode = 'key mode = 'value-done] [return none]
          append-token 'rbracket "]" char-line char-column
          drop-context
          when not note-value-produced [return none]
          handled?: true
        ]
      ]

      when not handled? [
        when char = "[" [
          when not flush-word [return none]
          when not ensure-value [return none]
          append-token 'lbracket "[" char-line char-column
          add-context 'array
          handled?: true
        ]
      ]

      when not handled? [
        when char = "]" [
          when not flush-word [return none]
          when depth = 0 [return none]
          when current-context <> 'array [return none]
          mode: pick array-modes depth
          when not any [mode = 'start mode = 'value-done] [return none]
          append-token 'rbracket "]" char-line char-column
          drop-context
          when not note-value-produced [return none]
          handled?: true
        ]
      ]

      when not handled? [
        when char = ":" [
          when not flush-word [return none]
          when depth = 0 [return none]
          when current-context <> 'object [return none]
          mode: pick object-modes depth
          when mode <> 'colon [return none]
          poke object-modes depth 'value
          handled?: true
        ]
      ]

      when not handled? [
        when char = "," [
          when not flush-word [return none]
          when depth = 0 [return none]
          type: current-context
          if type = 'object [
            mode: pick object-modes depth
            when mode <> 'value-done [return none]
            poke object-modes depth 'key
          ] [
            if type = 'array [
              mode: pick array-modes depth
              when mode <> 'value-done [return none]
              poke array-modes depth 'value
            ] [
              return none
            ]
          ]
          handled?: true
        ]
      ]

      when not handled? [
        when any [char = " " char = "\t" char = "\n" char = "\r"] [
          when not flush-word [return none]
          handled?: true
        ]
      ]

      when not handled? [
        when find word-charset char-string [
          when (length? word) = 0 [
            word-line: char-line
            word-column: char-column
          ]
          word: append word char
          handled?: true
        ]
      ]

      when not handled? [
        return none
      ]
    ]

    idx: idx + 1
    if char = "\n" [
      line: line + 1
      column: 1
    ] [
      if char = "\r" [
        line: line + 1
        column: 1
      ] [
        column: column + 1
      ]
    ]
  ]

  when not flush-word [return none]
  when state <> 'base [return none]
  when depth <> 0 [return none]
  when root-mode <> 'done [return none]

  tokens
]

json.tokenize: fn [string] [
  tokens: json.tokens-from-json string
  when tokens = none [
    return none
  ]
  tokens
]

json.parse: fn [string] [
  tokens: json.tokenize string
  when tokens = none [
    return none
  ]
  values: parse tokens
  do values
]

json
