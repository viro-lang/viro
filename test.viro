win: webui-new-window

webui-show win "
<html>
<head><script src='webui.js'></script></head>
<body>
  <h1>Test!</h1>
  <button id='test'>Klinij!</button>
</body>
</html>
"


probe webui-bind win "test" [
  print "Hello World!"
  print event-element
  print event-data
  print event-window-id
  print event-number
]


webui-wait


