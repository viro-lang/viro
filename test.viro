win: webui-new-window

webui-bind win "test" [
  print "Hello World!"
  print mold event
]

webui-bind win "myFun" [
  print "Callback?"
  print mold event
]


webui-show win "
<html>
<head>
  <meta charset='utf-8' /> 
  <script src='webui.js'></script>
  <script>
    function hello() {
      myFun(42)
    }
    hello()
  </script>
</head>
<body>
  <h1>Test!</h1>
  <button id='test'>Klinij!</button>

  <button
    onclick=\"myFun(true)\"
    >Coś innego</button>
</body>
</html>
"



webui-wait


