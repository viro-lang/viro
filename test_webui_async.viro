; Test script for non-blocking webui-show behavior
; This script demonstrates that webui-show returns immediately
; and the window stays open until webui-wait

print "Creating window..."
window-id: webui-new-window

print "Showing window with HTML content..."
result: webui-show window-id "<html><body><h1>Non-blocking Test</h1><p>This window should appear immediately!</p></body></html>"

print ["webui-show returned:" result]
print "Script continues executing..."
print "Window should still be visible"

print "Calling webui-wait to block until window closes..."
webui-wait

print "Window closed, script finished"
